# shelf 飞牛部署环境变量模板
# 复制为同目录 .env 后按需修改（飞牛也会注入 TRIM_SERVICE_PORT 作为访问端口）

# ---- 必改 ----
# 宿主机媒体目录（有声书文件），容器内固定挂载到 /audiobooks:ro
AUDIOBOOKS_PATH=/volume1/media/audiobooks

# ---- 数据目录（数据库/缓存，必须本地盘）----
ECHOSHELF_DATA_PATH=/volume1/docker/shelf

# ---- 宿主机映射端口（容器内固定 8080；飞牛由 TRIM_SERVICE_PORT 注入，无需在此设置）----
SHELF_HOST_PORT=8080

# ---- 管理员（启动后无法在网页端创建，只能带外创建）----
ECHOSHELF_ADMIN_USERNAME=admin
# 二选一：明文密码（至少 8 位），或指向 Docker secret 文件的 *_FILE（优先）
ECHOSHELF_ADMIN_PASSWORD=
# ECHOSHELF_ADMIN_PASSWORD_FILE=/run/secrets/echoshelf_admin
# 开启后每次启动都把上面的密码同步到管理员（改完重启即生效）
ECHOSHELF_ADMIN_SYNC_PASSWORD=false

# ---- 可选 ----
TZ=Asia/Shanghai
ECHOSHELF_LOG_LEVEL=info
ECHOSHELF_ALLOW_REGISTRATION=false
# 弱 NAS 建议关转码
ECHOSHELF_ENABLE_TRANSCODE=true
# 运行身份，需对媒体目录有读权限
PUID=1000
PGID=1000
ECHOSHELF_CPUS=2.0
ECHOSHELF_MEMORY=1g
